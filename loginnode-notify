def cmd_send(cfg: Config, a) -> int:
    run = run_dir(cfg, a.run)
    targets = load_run_file(run, "targets.json", "run review first")
    with SendLock(cfg):
        log = read_log(cfg)
        sent_here = {e["user"] for e in log if e["run"] == run.name and e["status"] == "sent"}
        sent, cutoff = last_sent(log), cfg.cooldown_cutoff()
        allow, excluded = read_allowlist(cfg), active_exclusions(cfg)

        drafts = drafts_dir(run, targets)
        ready, plan, skipped = [], [], []
        for r in selected_targets(targets, split_csv(a.only)):
            u = r["user"]
            draft = drafts / f"to{u}"
            if not draft.exists():
                reason = "no draft (run compose)"
            elif is_listed(allow, u):
                reason = "allowlist"
            elif not targets["include_emailed"] and is_listed(excluded, u):
                reason = "in excluded.txt"
            elif u in sent_here:
                reason = "already sent in this run"
            elif not targets["ignore_cooldown"] and sent.get(u, "") >= cutoff:
                reason = f"sent {sent[u]} (cooldown {cfg.cooldown_days}d)"
            else:
                reason = None
            if reason:
                skipped.append((u, reason))
            else:
                ready.append(r)

        # Resolve addresses even for a self-test, so it shows who would get what.
        emails = Emails(cfg)
        addr = emails.lookup([r["user"] for r in ready])
        self_to = self_test_address(cfg) if a.self_test else None
        for r in ready:
            u = r["user"]
            if not addr[u]:
                skipped.append((u, f"no email in the directory (add one to {cfg.addresses_file.name})"))
                continue
            headers, body = parse_draft(drafts / f"to{u}")
            subject = headers.get("subject") or cfg.default_subject
            if a.self_test:
                subject = f"[self-test for {u} <{addr[u]}>] {subject}"
            msg = make_message(cfg, self_to or addr[u], subject, body, headers.get("reply-to"))
            plan.append((r, msg))

        for r, msg in plan:
            print(f"\n===== {r['user']} [{log_category(r)}]")
            show_message(msg)
        if skipped:
            print("\nskipped:")
            for u, reason in skipped:
                print(f"  {u:<16} {reason}")
        print()
        if not plan:
            print("nothing to send")
            return 0
        limit = a.max_recipients or cfg.max_recipients
        if len(plan) > limit:
            die(f"{len(plan)} messages exceed the cap of {limit}; use --only, or "
                f"--max-recipients deliberately")
        dest = f"{self_to} (self-test)" if a.self_test else f"{len(plan)} recipient(s)"
        if not a.send:
            print(f"dry run: {len(plan)} message(s) to {dest} via {cfg.sendmail[0]}; "
                  f"nothing sent. Add --send to deliver.")
            return 0
        if not a.yes:
            confirm(f"Send {len(plan)} message(s) to {dest}?")

        ok = failed = 0
        for r, msg in plan:
            err = deliver(cfg, msg)
            if err:
                print(f"FAILED {r['user']}: {err}")
                failed += 1
                continue
            append_log(cfg, run.name, r["user"], log_category(r), msg["Subject"],
                       "selftest" if a.self_test else "sent", msg.get_content())
            print(f"sent   {r['user']} -> {msg['To']}")
            ok += 1
            if a.write_nudge and not a.self_test:
                nudge(cfg, r["user"], r["hosts"])
        print(f"\n{ok} sent, {failed} failed" +
              (" - failures were not logged; fix and re-run send (sent users are skipped)"
               if failed else ""))
        return 1 if failed else 0


def cmd_selftest(cfg: Config, a) -> int:
    to = self_test_address(cfg)
    body = (f"Transport test for loginnode-notify.\n\n"
            f"  host       {short_host()}\n"
            f"  sendmail   {' '.join(cfg.sendmail)}\n"
            f"  From:      {cfg.mail_from}\n"
            f"  To:        {to} (directory email of {cfg.self_test_netid})\n"
            f"  Reply-To:  {cfg.reply_to}\n\n"
            f"Recipients are looked up the same way. If you can read this, delivery\n"
            f"works. No user was contacted; this is logged as selftest and creates no\n"
            f"cooldown entry.\n\n{cfg.signature}\n")
    msg = make_message(cfg, to, "loginnode-notify transport test", body)
    show_message(msg)
    print()
    if not a.send:
        print(f"dry run; add --send to post it to {to}")
        return 0
    if not a.yes:
        confirm(f"Send this test to {to}?")
    err = deliver(cfg, msg)
    if err:
        die(f"sendmail rejected the message: {err}")
    append_log(cfg, "smoke", to, "smoke", msg["Subject"], "selftest", body)
    print("posted; check your inbox (and spam)")
    return 0


def cmd_check(cfg: Config, a) -> int:
    problems = 0

    def bad(msg: str) -> None:
        nonlocal problems
        problems += 1
        print(f"  PROBLEM: {msg}")

    sm = shutil.which(cfg.sendmail[0])
    cur = cfg.state / "current"
    print(f"host        {short_host()}")
    print(f"config      {cfg.path}{'' if cfg.path.exists() else ' (missing - using defaults)'}")
    print(f"local       {cfg.local_path}{'' if cfg.local_path.exists() else ' (none)'}")
    print(f"from        {cfg.mail_from}")
    print(f"reply-to    {cfg.reply_to}")
    probe = Emails(cfg).one(cfg.self_test_netid)
    print(f"directory   {cfg.self_test_netid} -> {probe or 'NOT FOUND'}"
          f"{'' if cfg.ldap_helper_dir else ' (LDAP off: etc/addresses.tsv only)'}")
    if not probe:
        bad(f"cannot resolve self_test_netid={cfg.self_test_netid}; recipients would not resolve either")
    print(f"sendmail    {' '.join(cfg.sendmail)} ({sm or 'NOT FOUND'})")
    if not sm:
        bad("no sendmail here; run on a login node or set sendmail in the config")
    print(f"finger      {shutil.which(cfg.finger) or 'not found (names fall back to getent)'}")
    print(f"state       {cfg.state}")
    print(f"notify log  {len(read_log(cfg))} entries, cooldown {cfg.cooldown_days} days")
    print(f"current run {cur.read_text().strip() if cur.exists() else '(none)'}")

    cats = load_categories(cfg)
    manual_only = [name for name, rx, _ in cats if rx is None]
    print(f"categories  {len(cats) - len(manual_only)} detected"
          + (f", manual-only: {', '.join(manual_only)}" if manual_only else ""))
    for path in (cfg.allowlist, cfg.allowlist_local, cfg.excluded):
        entries = read_list(path)
        print(f"{path.name:<11} {len(entries)} entries")
        for pat, rest, n in entries:
            if len(rest) > 1:
                bad(f"{path.name}:{n}: extra fields after '{pat} {rest[0]}' are ignored")
            if path == cfg.excluded and rest:
                try:
                    dt.date.fromisoformat(rest[0])
                except ValueError:
                    bad(f"{path.name}:{n}: '{rest[0]}' is not a YYYY-MM-DD date "
                        f"(entry stays permanent)")
    for tpl in sorted(cfg.templates.glob("*.txt")):
        headers, body = parse_draft(tpl)
        unknown = set(PLACEHOLDER_RE.findall(tpl.read_text())) - set(PLACEHOLDERS)
        if unknown:
            bad(f"templates/{tpl.name}: unknown placeholder(s) {', '.join(sorted(unknown))}")
        if "subject" not in headers:
            bad(f"templates/{tpl.name}: no Subject header")
    for cat in sorted(cfg.stale_categories):
        if not any((cfg.templates / n).exists() for n in (f"stale_{cat}.txt", "stale.txt")):
            bad(f"no templates/stale_{cat}.txt or templates/stale.txt for `review --stale`")
    print(f"templates   {len(list(cfg.templates.glob('*.txt')))} checked")
    print("\nOK" if not problems else f"\n{problems} problem(s)")
    return 1 if problems else 0


def cmd_report(cfg: Config, a) -> int:
    run = run_dir(cfg, a.run)
    print(f"run         {run.name}")
    if (run / "candidates.json").exists():
        cand = json.loads((run / "candidates.json").read_text())
        print(f"candidates  {len(cand['rows'])} rows, {len({r['user'] for r in cand['rows']})} users "
              f"on {', '.join(cand['hosts_scanned'])}")
    selected = []
    if (run / "targets.json").exists():
        users = json.loads((run / "targets.json").read_text())["users"]
        selected = [r["user"] for r in users if r["selected"]]
        print(f"eligible    {sum(r['status'] == 'eligible' for r in users)}")
        print(f"selected    {len(selected)}")
    for d in ("drafts", "drafts-stale"):
        if (run / d).is_dir():
            print(f"{d:<11} {len(list((run / d).glob('to*')))}")
    entries = [e for e in read_log(cfg) if e["run"] == run.name]
    sent = {e["user"] for e in entries if e["status"] == "sent"}
    print(f"sent        {len(sent)}")
    unsent = [u for u in selected if u not in sent]
    if unsent:
        print(f"not sent    {' '.join(unsent)}")
    if entries:
        print("\nnotices for this run:")
        for e in entries:
            print(f"  {e['ts']}  {e['user']:<16} {e['category']:<16} {e['status']}")
    return 0


def cmd_log(cfg: Config, a) -> int:
    print(f"{'WHEN':<21} {'RUN':<16} {'USER':<16} {'CATEGORY':<16} {'STATUS':<9} SUBJECT")
    for e in read_log(cfg)[-a.n:]:
        print(f"{e['ts']:<21} {e['run']:<16} {e['user']:<16} {e['category']:<16} "
              f"{e['status']:<9} {e['subject']}")
    return 0


def cmd_recheck(cfg: Config, a) -> int:
    rows, scanned, failed = scan_all(cfg, cfg.min_etime, False, a.all_nodes, a.ps_file)
    days = cfg.cooldown_days if a.days is None else a.days
    cutoff = iso(now() - dt.timedelta(days=days))
    contacted = {u: ts for u, ts in last_sent(read_log(cfg)).items() if ts >= cutoff}
    seen: dict[str, dict] = {}
    for r in rows:
        if r["user"] in contacted:
            s = seen.setdefault(r["user"], {"cats": set(), "hosts": set(), "etime": 0})
            s["cats"].add(r["category"])
            s["hosts"].add(r["host"])
            s["etime"] = max(s["etime"], r["max_etime"])
    print(f"{'USER':<16} {'NOW RUNNING':<22} {'HOSTS':<13} {'OLDEST':>7}  CONTACTED")
    t_now = now()
    for u in sorted(seen):
        s = seen[u]
        told = dt.datetime.strptime(contacted[u], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
        same = " (same process as at notice)" if s["etime"] > (t_now - told).total_seconds() else ""
        print(f"{u:<16} {','.join(sorted(s['cats'])):<22} {','.join(sorted(s['hosts'])):<13} "
              f"{fmt_dur(s['etime']):>7}  {contacted[u]}{same}")
    print(f"\n{len(seen)} of {len(contacted)} user(s) contacted in the last {days} days are "
          f"still flagged on {', '.join(scanned)}" + (f" (FAILED: {', '.join(failed)})" if failed else ""))
    print("a second notice is a judgement call - reply personally rather than re-running send")
    return 0


# --- command line -----------------------------------------------------------

def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="loginnode-notify", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--config", type=Path, default=DEFAULT_CONFIG,
                   help=f"config file (default {DEFAULT_CONFIG.relative_to(ROOT)})")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

    def add(name: str, func, help: str | None):
        sp = sub.add_parser(name, help=help) if help else sub.add_parser(name)
        sp.set_defaults(func=func)
        return sp

    def with_run(sp):
        sp.add_argument("--run", help="run id (default: state/current)")
        return sp

    add("check", cmd_check, "config, transport and template sanity check")

    sp = add("detect", cmd_detect, "scan login nodes and start a new run")
    sp.add_argument("--all-nodes", action="store_true", help="also scan the other login_nodes over ssh")
    sp.add_argument("--include-alloc", action="store_true", help="keep processes inside Slurm allocations")
    sp.add_argument("--min-etime", type=int, help="ignore processes younger than this (s)")
    sp.add_argument("--ps-file", help=argparse.SUPPRESS)

    sp = add("scan", cmd_scan, None)
    sp.add_argument("--min-etime", type=int, default=600)
    sp.add_argument("--include-alloc", action="store_true")
    sp.add_argument("--ps-file")

    sp = with_run(add("review", cmd_review, "choose who to contact (one row per user)"))
    g = sp.add_mutually_exclusive_group()
    g.add_argument("--all", action="store_true", help="select every eligible user")
    g.add_argument("--pick", help="select rows, e.g. 1,3,5-7")
    g.add_argument("-i", "--interactive", action="store_true", help="show the table, then ask")
    sp.add_argument("--only-category", action="append", help="consider only these categories (comma list)")
    sp.add_argument("--exclude", action="append", help="never select these netIDs (comma list)")
    sp.add_argument("--ignore-cooldown", action="store_true")
    g = sp.add_mutually_exclusive_group()
    g.add_argument("--include-stale", action="store_true",
                   help="treat stale servers like active ones (normal templates)")
    g.add_argument("--stale", action="store_true",
                   help="cleanup notices: only stale servers count, stale_<cat>/stale templates")
    sp.add_argument("--stale-days", type=int,
                    help="stale threshold in days for this review (default stale_etime_days)")
    sp.add_argument("--include-emailed", action="store_true", help="ignore etc/excluded.txt")
    sp.add_argument("--max-recipients", type=int, help="raise the per-run cap for this run")

    sp = with_run(add("compose", cmd_compose, "write one draft per selected user"))
    sp.add_argument("--force", action="store_true", help="overwrite existing drafts")
    sp.add_argument("--only", action="append", help="only these netIDs (comma list)")

    sp = with_run(add("add", cmd_add, "flag users by hand with a category (e.g. io_heavy)"))
    sp.add_argument("category", help="a category from etc/categories.tsv")
    sp.add_argument("netids", nargs="+", help="netIDs (space or comma separated)")
    sp.add_argument("--note", help="sentence for {{NOTE}} in the template, e.g. what you saw")
    sp.add_argument("--host", help="where you saw it (default: this host)")
    sp.add_argument("--remove", action="store_true", help="drop these manual flags instead")

    with_run(add("names", cmd_names, "netID -> greeting for the run's selection"))
    sp = add("name", cmd_name, "resolve names now")
    sp.add_argument("netids", nargs="+")

    sp = add("selftest", cmd_selftest, "one test message to yourself")
    sp.add_argument("--send", action="store_true")
    sp.add_argument("--yes", "-y", action="store_true")

    sp = with_run(add("send", cmd_send, "deliver drafts (dry run unless --send)"))
    sp.add_argument("--send", action="store_true", help="actually deliver")
    sp.add_argument("--yes", "-y", action="store_true", help="do not ask for YES")
    sp.add_argument("--only", action="append", help="only these netIDs (comma list)")
    sp.add_argument("--self-test", action="store_true", help="send every message to self_test_netid instead")
    sp.add_argument("--write-nudge", action="store_true", help="also `write` to their terminals")
    sp.add_argument("--max-recipients", type=int, help="raise the per-run cap for this send")

    with_run(add("report", cmd_report, "what the run selected and sent"))
    sp = add("log", cmd_log, "recent notify.log entries")
    sp.add_argument("n", nargs="?", type=int, default=20)
    sp = add("recheck", cmd_recheck, "contacted users who are still flagged")
    sp.add_argument("--all-nodes", action="store_true")
    sp.add_argument("--days", type=int, help="look back this many days (default cooldown_days)")
    sp.add_argument("--ps-file", help=argparse.SUPPRESS)

    a = p.parse_args(argv)
    if not getattr(a, "func", None):
        p.print_help()
        return 2
    return a.func(Config(a.config), a)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
