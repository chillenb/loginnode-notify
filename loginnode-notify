def cmd_scan(cfg: Config, a) -> int:
    """Internal: one host's rows as JSON, for detect --all-nodes over ssh."""
    print(json.dumps(scan_local(cfg, a.min_etime, a.include_alloc,
                                Path(a.ps_file).read_text() if a.ps_file else None)))
    return 0


def cmd_detect(cfg: Config, a) -> int:
    min_etime = cfg.min_etime if a.min_etime is None else a.min_etime
    rows, scanned, failed = scan_all(cfg, min_etime, a.include_alloc, a.all_nodes, a.ps_file)
    rows.sort(key=lambda r: (r["user"], -r["rss_mb"]))
    base_id = now().strftime("%Y%m%d-%H%M%S")
    for n in range(1, 100):   # two detects in one second must not collide
        run_id = base_id if n == 1 else f"{base_id}-{n}"
        run = cfg.state / "runs" / run_id
        try:
            run.mkdir()
            break
        except FileExistsError:
            continue
    else:
        die(f"could not create a run directory for {base_id}")
    write_json(run / "candidates.json", {
        "run": run_id, "generated": iso(now()), "min_etime": min_etime,
        "heavy_rss_mb": cfg.heavy_rss_mb, "include_alloc": a.include_alloc,
        "hosts_scanned": scanned, "hosts_failed": failed, "rows": rows})
    (cfg.state / "current.tmp").write_text(run_id + "\n")
    os.replace(cfg.state / "current.tmp", cfg.state / "current")

    print(f"{'USER':<16} {'HOST':<8} {'CATEGORY':<12} {'PROCS':>5} {'OLDEST':>7} {'RSS':>8}  WHAT")
    for r in rows:
        print(f"{r['user']:<16} {r['host']:<8} {r['category']:<12} {r['procs']:>5} "
              f"{fmt_dur(r['max_etime']):>7} {r['rss_mb']:>7}M  {r['label']}")
    print(f"\n{len(rows)} row(s), {len({r['user'] for r in rows})} user(s) on "
          f"{', '.join(scanned)}" + (f"; FAILED: {', '.join(failed)}" if failed else ""))
    print(f"run {run_id} is now current - next: loginnode-notify review")
    return 0


def cmd_add(cfg: Config, a) -> int:
    """Flag users by hand (e.g. heavy I/O seen in iotop) in the current run.
    They then go through review/compose/send like detected users."""
    run = run_dir(cfg, a.run)
    path = run / "candidates.json"
    cand = load_run_file(run, "candidates.json", "run detect first")
    labels: dict[str, str] = {}
    for name, _, label in load_categories(cfg):
        labels.setdefault(name, label)   # a category's first line names it
    labels.setdefault(*HEAVY)
    if a.category not in labels:
        die(f"unknown category '{a.category}' (known: {', '.join(labels)}); add a line to "
            f"{cfg.categories_file.name}, with - as the regex for a manual-only reason")
    users = split_csv(a.netids)
    keep = [r for r in cand["rows"]
            if not (r.get("manual") and r["user"] in users and r["category"] == a.category)]
    if a.remove:
        cand["rows"] = keep
        write_json(path, cand)
        print(f"removed manual '{a.category}' for {', '.join(users)} from run {run.name}")
        print("next: loginnode-notify review")
        return 0
    addr = Emails(cfg).lookup(users)
    host = a.host or short_host()
    for u in users:
        keep.append({"user": u, "host": host, "category": a.category,
                     "label": labels[a.category], "procs": 0, "max_etime": 0, "rss_mb": 0,
                     "pids": [], "in_alloc": False, "manual": True, "note": a.note or ""})
        print(f"{u:<16} {a.category:<12} {host:<8} {addr[u] or 'NO EMAIL - send will skip them'}")
    cand["rows"] = keep
    write_json(path, cand)
    print(f"\nadded to run {run.name}; next: loginnode-notify review "
          f"(allowlist, excluded.txt and cooldown still apply)")
    return 0


def parse_pick(spec: str, n: int) -> set[int]:
    out: set[int] = set()
    for part in spec.replace(" ", "").split(","):
        if not part:
            continue
        m = re.fullmatch(r"(\d+)(?:-(\d+))?", part)
        if not m:
            die(f"bad row selection '{part}' (use e.g. 1,3,5-7)")
        lo, hi = int(m.group(1)), int(m.group(2) or m.group(1))
        if not 1 <= lo <= hi <= n:
            die(f"row selection '{part}' is outside 1-{n}")
        out.update(range(lo, hi + 1))
    return out


def print_review(records: list[dict]) -> None:
    print(f"{'#':>3}  {'USER':<16} {'WHAT':<24} {'HOSTS':<13} {'OLDEST':>7} {'RSS':>8}  STATUS")
    for i, r in enumerate(records, 1):
        what = ",".join(r["categories"])
        if r["dropped"]:
            what += " (+" + ",".join(r["dropped"]) + ")"
        status = ("SELECTED" if r["selected"] else
                  "eligible" if r["status"] == "eligible" else "no: " + r["status"])
        oldest = "manual" if r.get("manual") and not r["max_etime"] else fmt_dur(r["max_etime"])
        print(f"{i:>3}  {r['user']:<16} {what:<24} {','.join(r['hosts']):<13} "
              f"{oldest:>7} {r['rss_mb']:>7}M  {status}")


def cmd_review(cfg: Config, a) -> int:
    run = run_dir(cfg, a.run)
    cand = load_run_file(run, "candidates.json", "it was made by the old bash pipeline; run detect")
    order = {name: i for i, (name, _, _) in enumerate(load_categories(cfg))}
    only, exclude = set(split_csv(a.only_category)), set(split_csv(a.exclude))
    allow, excluded = read_allowlist(cfg), active_exclusions(cfg)
    sent, cutoff = last_sent(read_log(cfg)), cfg.cooldown_cutoff()

    per_user: dict[str, dict[str, dict]] = {}
    for r in cand["rows"]:
        c = per_user.setdefault(r["user"], {}).setdefault(r["category"], {
            "label": r["label"], "hosts": set(), "procs": 0, "max_etime": 0, "rss_mb": 0,
            "manual": False, "notes": []})
        c["hosts"].add(r["host"])
        c["manual"] = c["manual"] or r.get("manual", False)
        if r.get("note"):
            c["notes"].append(r["note"])
        c["procs"] += r["procs"]
        c["max_etime"] = max(c["max_etime"], r["max_etime"])
        c["rss_mb"] += r["rss_mb"]

    stale_days = cfg.stale_days if a.stale_days is None else a.stale_days
    if a.stale and stale_days <= 0:
        die("--stale needs a positive stale_etime_days (or --stale-days N)")

    def is_stale(name: str, c: dict) -> bool:
        return (stale_days > 0 and name in cfg.stale_categories
                and c["max_etime"] > stale_days * 86400)

    records = []
    for user in sorted(per_user):
        cats = per_user[user]
        counted, dropped = [], {}
        # Manually added reasons first: their template (and note) is the one used.
        for name in sorted(cats, key=lambda n: (not cats[n]["manual"], order.get(n, len(order)), n)):
            if only and name not in only:
                dropped[name] = "category-filter"
            elif a.stale:
                # --stale: the orphaned servers are the message; everything else waits
                if is_stale(name, cats[name]):
                    counted.append(name)
                else:
                    dropped[name] = "not-stale"
            elif not a.include_stale and is_stale(name, cats[name]):
                dropped[name] = f"stale>{stale_days}d"
            else:
                counted.append(name)
        if is_listed(allow, user):
            status = "allowlist"
        elif not a.include_emailed and is_listed(excluded, user):
            status = "already-emailed"
        elif user in exclude:
            status = "excluded"
        elif not counted:
            status = ",".join(sorted(set(dropped.values())))
        elif not a.ignore_cooldown and sent.get(user, "") >= cutoff:
            status = f"cooldown (sent {sent[user][:10]})"
        else:
            status = "eligible"
        shown = counted or list(dropped)
        records.append({
            "user": user, "categories": shown,
            "labels": [cats[n]["label"] for n in shown],
            "hosts": sorted(set().union(*(cats[n]["hosts"] for n in shown))),
            "procs": sum(cats[n]["procs"] for n in shown),
            "max_etime": max(cats[n]["max_etime"] for n in shown),
            "rss_mb": sum(cats[n]["rss_mb"] for n in shown),
            "dropped": sorted(dropped) if counted else [],
            "manual": any(cats[n]["manual"] for n in shown),
            "notes": [note for n in shown for note in cats[n]["notes"]],
            "stale": a.stale, "status": status, "selected": False})

    pick = a.pick
    mode = "all" if a.all else "pick" if pick else "interactive" if a.interactive else "preview"
    if mode == "interactive":
        print_review(records)
        ans = input("\nSelect rows (e.g. 1,3,5-7), 'all', or 'none': ").strip()
        mode, pick = ("preview", None) if ans in ("", "none") else ("all", None) if ans == "all" else ("pick", ans)
    if mode == "all":
        chosen = {i for i, r in enumerate(records, 1) if r["status"] == "eligible"}
    elif mode == "pick":
        chosen = parse_pick(pick, len(records))
    else:
        chosen = set()
    for i in sorted(chosen):
        r = records[i - 1]
        if r["status"] == "eligible":
            r["selected"] = True
        else:
            warn(f"row {i} ({r['user']}) is not eligible ({r['status']}); not selected")

    nsel = sum(r["selected"] for r in records)
    limit = a.max_recipients or cfg.max_recipients
    if nsel > limit:
        die(f"{nsel} users selected but the cap is {limit}; narrow the pick or pass "
            f"--max-recipients deliberately (nothing written)")
    write_json(run / "targets.json", {
        "run": run.name, "generated": iso(now()), "mode": mode,
        "ignore_cooldown": a.ignore_cooldown, "include_emailed": a.include_emailed,
        "stale": a.stale, "users": records})

    print()
    print_review(records)
    eligible = sum(r["status"] == "eligible" for r in records)
    print(f"\n{len(records)} user(s), {eligible} eligible, {nsel} selected"
          + (f" - STALE mode: servers older than {stale_days}d, stale_* templates" if a.stale else ""))
    only_stale = sum(r["status"].startswith("stale>") for r in records)
    if only_stale and not a.stale:
        print(f"{only_stale} user(s) have only stale servers; to ask them to clean up: "
              f"loginnode-notify review --stale")
    if nsel:
        print("next: loginnode-notify compose")
    else:
        print("nothing selected; re-run with --all, --pick 1,3,5-7 or -i")
    return 0


def expand_each_host(text: str, hosts: list[str]) -> str:
    """A template line starting with {{FOR_EACH_HOST}} is repeated once per host
    the user was seen on, with {{HOST}} filled in, e.g.
        {{FOR_EACH_HOST}}    ssh {{HOST}} 'pkill ...'"""
    out = []
    for line in text.splitlines(keepends=True):
        if line.startswith(EACH_HOST):
            body = line[len(EACH_HOST):]
            out += [body.replace("{{HOST}}", h) for h in hosts]
        else:
            out.append(line)
    return "".join(out)


def drafts_dir(run: Path, targets: dict) -> Path:
    """Stale-cleanup drafts live apart, so they never replace a normal draft."""
    return run / ("drafts-stale" if targets.get("stale") else "drafts")


def log_category(r: dict) -> str:
    """notify.log category field; stale cleanup notices read e.g. stale:ide."""
    return ("stale:" if r.get("stale") else "") + ",".join(r["categories"])


def template_for(cfg: Config, r: dict) -> Path:
    cat = r["categories"][0]
    if r.get("stale"):
        for name in (f"stale_{cat}.txt", "stale.txt"):
            if (cfg.templates / name).exists():
                return cfg.templates / name
        die(f"no templates/stale_{cat}.txt or templates/stale.txt for stale cleanup notices")
    tpl = cfg.templates / f"{cat}.txt"
    return tpl if tpl.exists() else cfg.templates / "default.txt"


def cmd_compose(cfg: Config, a) -> int:
    run = run_dir(cfg, a.run)
    targets = load_run_file(run, "targets.json", "run review first")
    sel = selected_targets(targets, split_csv(a.only))
    if not sel:
        die("no selected users in this run (review selected nothing?)")
    drafts = drafts_dir(run, targets)
    drafts.mkdir(exist_ok=True)
    names = Names(cfg)
    made = kept = 0
    for r in sel:
        u = r["user"]
        dst = drafts / f"to{u}"
        if dst.exists() and not a.force:
            print(f"{u:<16} kept your existing draft (use --force to regenerate)")
            kept += 1
            continue
        tpl = template_for(cfg, r)
        full = names.full(u)
        if not full:
            warn(f"no directory name for {u}; greeting uses the netID")
        values = {
            "NAME": names.greeting(u), "FULLNAME": full or u, "USER": u,
            "AGENT": join_words(r["labels"]), "HOSTS": join_words(r["hosts"]),
            "OLDEST": fmt_dur(r["max_etime"]), "DAYS": str(r["max_etime"] // 86400),
            "PROCS": str(r["procs"]),
            "SIGNATURE": cfg.signature, "REPLY_TO": cfg.reply_to, "SUPPORT": cfg.support,
            "NOTE": " ".join(r.get("notes", []))}
        text = expand_each_host(tpl.read_text(), r["hosts"])
        for key, val in values.items():
            text = text.replace("{{" + key + "}}", val)
        text = re.sub(r"[ \t]+\n", "\n", text)   # an empty {{NOTE}} leaves trailing spaces
        for left in sorted(set(PLACEHOLDER_RE.findall(text))):
            warn(f"to{u}: unknown placeholder {{{{{left}}}}} left in the draft")
        dst.write_text(text)
        print(f"{u:<16} {values['NAME']:<14} {tpl.name}")
        made += 1
    print(f"\n{made} draft(s) written, {kept} kept, in {drafts}")
    print("read and edit them, then: loginnode-notify send")
    return 0


