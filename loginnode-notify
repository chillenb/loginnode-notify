ROOT = Path(__file__).resolve().parent
DEFAULT_CONFIG = ROOT / "etc" / "notify.ini"
PLACEHOLDERS = ("NAME", "FULLNAME", "USER", "AGENT", "HOSTS", "OLDEST", "PROCS",
                "SIGNATURE", "REPLY_TO", "SUPPORT", "NOTE", "DAYS", "FOR_EACH_HOST", "HOST")
EACH_HOST = "{{FOR_EACH_HOST}}"
PLACEHOLDER_RE = re.compile(r"\{\{([A-Z_]+)\}\}")
HEADER_RE = re.compile(r"^([A-Za-z][A-Za-z-]*):[ \t]*(.*)$")
DRAFT_HEADERS = ("subject", "reply-to")   # anything else in a draft is ignored
HEAVY = ("heavy", "a high-memory login-node process")


# --- small helpers ----------------------------------------------------------

def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def warn(msg: str) -> None:
    print(f"warning: {msg}", file=sys.stderr)


def now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso(t: dt.datetime) -> str:
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def short_host() -> str:
    return socket.gethostname().split(".")[0]


def fmt_dur(s: int) -> str:
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    if d:
        return f"{d}d{h}h"
    if h:
        return f"{h}h{m:02d}m"
    return f"{m}m" if m else f"{s}s"


def join_words(items: list[str]) -> str:
    if len(items) <= 1:
        return "".join(items)
    return ", ".join(items[:-1]) + " and " + items[-1]


def split_csv(values: list[str] | None) -> list[str]:
    return [v for item in values or [] for v in item.split(",") if v.strip()]


def write_json(path: Path, obj) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(obj, indent=1) + "\n")
    os.replace(tmp, path)


def confirm(prompt: str) -> None:
    if not sys.stdin.isatty():
        die("no terminal to confirm on; re-run with --yes when you mean it")
    if input(f"{prompt} Type YES to confirm: ").strip() != "YES":
        print("cancelled")
        sys.exit(1)


