    def __init__(self, path: Path):
        cp = configparser.ConfigParser(interpolation=None)
        cp.read_dict({"notify": self.DEFAULTS})
        if not path.exists() and path != DEFAULT_CONFIG:
            die(f"config file not found: {path}")
        # notify.local.ini next to the config overrides it; it holds personal
        # settings (sender, signature) and is not committed.
        self.local_path = path.with_name(f"{path.stem}.local{path.suffix}")
        for p in (path, self.local_path):
            if p.exists():
                try:
                    cp.read(p)
                except configparser.Error as e:
                    die(f"{p}: {e}")
        s = cp["notify"]
        for key in s:
            if key not in self.DEFAULTS:
                warn(f"{path.name}: unknown setting '{key}' ignored")

        def where(key: str) -> Path:
            p = Path(os.path.expanduser(s[key]))
            return p if p.is_absolute() else ROOT / p

        self.path = path.resolve()
        self.mail_domain = s["mail_domain"]
        self._mail_from = s["mail_from"]
        self._reply_to = s["reply_to"]
        self.self_test_netid = s["self_test_netid"] or os.environ.get("USER", "unknown")
        self.signature = s["signature"]
        self.support = s["support"]
        self.default_subject = s["default_subject"]
        self.login_nodes = s["login_nodes"].split()
        self.ssh = shlex.split(s["ssh"])
        self.min_etime = s.getint("min_etime")
        self.heavy_rss_mb = s.getint("heavy_rss_mb")
        self.stale_days = s.getint("stale_etime_days")
        self.stale_categories = set(s["stale_categories"].split())
        self.cooldown_days = s.getint("cooldown_days")
        self.max_recipients = s.getint("max_recipients")
        self.exclude_days = s.getint("exclude_days")
        self.sendmail = shlex.split(s["sendmail"])
        self.envelope_from = s["envelope_from"]
        self.ldap_python = s["ldap_python"]
        self.ldap_helper_dir = s["ldap_helper_dir"]
        self.finger = s["finger"]
        self.greet_first = s.getboolean("name_greeting_first")
        self.state = where("state_dir")
        etc = where("etc_dir")
        self.categories_file = etc / "categories.tsv"
        self.allowlist = etc / "allowlist.txt"
        self.allowlist_local = etc / "allowlist.local.txt"   # personal additions, not committed
        self.excluded = etc / "excluded.txt"
        self.names_file = etc / "names.tsv"
        self.addresses_file = etc / "addresses.tsv"
        self.templates = where("templates_dir")
        self.log_path = self.state / "notify.log"
        self.name_cache = self.state / "names.cache"
        (self.state / "runs").mkdir(parents=True, exist_ok=True)

    @property
    def mail_from(self) -> str:
        """From: address; empty mail_from = your own address in the directory
        (never <netid>@yale.edu, which Yale's mail drops)."""
        if not self._mail_from:
            user = os.environ.get("USER", "unknown")
            self._mail_from = Emails(self).one(user) or die(
                f"no directory email for {user}; set mail_from in {self.local_path.name}")
        return self._mail_from

    @property
    def reply_to(self) -> str:
        return self._reply_to or self.mail_from

    def cooldown_cutoff(self) -> str:
        return iso(now() - dt.timedelta(days=self.cooldown_days))


# --- allowlist / excluded.txt ----------------------------------------------
# One entry per line: netID or prefix* first, optional fields after, # comments.
# Spaces and tabs both separate fields.

def read_list(path: Path) -> list[tuple[str, list[str], int]]:
    if not path.exists():
        return []
    out = []
    for n, raw in enumerate(path.read_text().splitlines(), 1):
        fields = raw.split("#", 1)[0].split()
        if fields:
            out.append((fields[0], fields[1:], n))
    return out


def read_allowlist(cfg: Config):
    return read_list(cfg.allowlist) + read_list(cfg.allowlist_local)


def is_listed(entries, user: str) -> bool:
    for pat, _, _ in entries:
        if (fnmatch.fnmatchcase(user, pat) if "*" in pat else pat == user):
            return True
    return False


def active_exclusions(cfg: Config):
    entries = read_list(cfg.excluded)
    if cfg.exclude_days <= 0:
        return entries
    cutoff = now().date() - dt.timedelta(days=cfg.exclude_days)
    out = []
    for e in entries:
        try:
            when = dt.date.fromisoformat(e[1][0]) if e[1] else None
        except ValueError:
            when = None   # unparseable date: keep excluding (fail closed)
        if when is None or when >= cutoff:
            out.append(e)
    return out


# --- notify.log -------------------------------------------------------------
# TAB separated: time  run  user  categories  subject  status(sent|selftest)  digest

def read_log(cfg: Config) -> list[dict]:
    if not cfg.log_path.exists():
        return []
    out = []
    for line in cfg.log_path.read_text().splitlines():
        f = line.split("\t")
        if len(f) >= 6:
            out.append({"ts": f[0], "run": f[1], "user": f[2], "category": f[3],
                        "subject": f[4], "status": f[5]})
    return out


def last_sent(log: list[dict]) -> dict[str, str]:
    out: dict[str, str] = {}
    for e in log:
        if e["status"] == "sent" and e["ts"] > out.get(e["user"], ""):
            out[e["user"]] = e["ts"]
    return out


def append_log(cfg: Config, run: str, user: str, category: str, subject: str,
               status: str, body: str) -> None:
    fields = [iso(now()), run, user, category, subject, status,
              hashlib.sha256(body.encode()).hexdigest()[:12]]
    line = "\t".join(re.sub(r"[\t\r\n]", " ", f) for f in fields) + "\n"
    with open(cfg.log_path, "a") as fh:
        fh.write(line)
        fh.flush()
        os.fsync(fh.fileno())


# --- detection --------------------------------------------------------------

def load_categories(cfg: Config) -> list[tuple[str, re.Pattern, str]]:
    if not cfg.categories_file.exists():
        die(f"missing {cfg.categories_file}")
    cats = []
    for n, line in enumerate(cfg.categories_file.read_text().splitlines(), 1):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.split("\t")
        if len(f) != 3:
            die(f"{cfg.categories_file.name}:{n}: expected 3 TAB-separated fields, got {len(f)}")
        try:
            # "-" = manual-only category: never detected, only set with `add`
            cats.append((f[0], None if f[1] == "-" else re.compile(f[1]), f[2]))
        except re.error as e:
            die(f"{cfg.categories_file.name}:{n}: bad regex: {e}")
    return cats


INTERPRETER_RE = re.compile(r"^(node|nodejs|bun|deno|npx|uvx|python[0-9.]*|ruby|perl|java|sh|bash|dash|zsh)$")


def program_of(args: str) -> str:
    """What a process runs: argv[0], plus the script or module when argv[0] is
    an interpreter (`node .../claude-code/cli.js`, `python -m jupyterlab`).
    Other arguments are ignored, so `tmux new -s claude`, `vim CLAUDE.md` or
    `rsync ... codex/` do not count as a coding agent."""
    toks = args.split()
    if not toks:
        return ""
    prog = [toks[0]]
    if INTERPRETER_RE.match(os.path.basename(toks[0])):
        rest = iter(toks[1:])
        for t in rest:
            if t in ("-c", "-e", "--eval", "-p", "--print"):   # inline code: nothing to name
                break
            if t == "-m":
                prog.append(next(rest, ""))
                break
            if not t.startswith("-"):
                prog.append(t)
                break
    return " ".join(prog).lower()


def in_slurm(pid: str) -> bool:
    try:
        return "slurm" in Path(f"/proc/{pid}/cgroup").read_text()
    except OSError:
        return False


def scan_local(cfg: Config, min_etime: int, include_alloc: bool,
               ps_text: str | None = None) -> list[dict]:
    """Aggregate this host's processes by (user, category). The program part of
    each command line (program_of) is matched against the category regexes;
    command lines are never stored."""
    if ps_text is None:
        ps_text = subprocess.run(
            ["ps", "-eo", "user:32,pid,etimes,rss,tty,args", "--no-headers"],
            stdin=subprocess.DEVNULL, capture_output=True, text=True,
            errors="replace", check=True).stdout
    host = short_host()
    cats = load_categories(cfg)
    allow = read_allowlist(cfg)
    agg: dict[tuple[str, str], dict] = {}
    for line in ps_text.splitlines():
        f = line.split(None, 5)
        if len(f) < 6:
            continue
        user, pid, etimes, rss, _tty, args = f
        if not (pid.isdigit() and etimes.isdigit() and rss.isdigit()):
            continue
        if user.isdigit() or is_listed(allow, user):   # numeric = no passwd entry
            continue
        if int(etimes) < min_etime:
            continue
        prog = program_of(args)
        cat = next(((name, label) for name, rx, label in cats if rx and rx.search(prog)), None)
        if cat is None:
            if int(rss) // 1024 < cfg.heavy_rss_mb:
                continue
            cat = HEAVY
        alloc = in_slurm(pid)
        if alloc and not include_alloc:
            continue
        r = agg.setdefault((user, cat[0]), {
            "user": user, "host": host, "category": cat[0], "label": cat[1],
            "procs": 0, "max_etime": 0, "rss_kb": 0, "pids": [], "in_alloc": False})
        r["procs"] += 1
        r["max_etime"] = max(r["max_etime"], int(etimes))
        r["rss_kb"] += int(rss)
        r["in_alloc"] = r["in_alloc"] or alloc
        if len(r["pids"]) < 8:
            r["pids"].append(int(pid))
    rows = list(agg.values())
    for r in rows:
        r["rss_mb"] = r.pop("rss_kb") // 1024
    return rows


def scan_all(cfg: Config, min_etime: int, include_alloc: bool, all_nodes: bool,
             ps_file: str | None = None):
    here = short_host()
    rows = scan_local(cfg, min_etime, include_alloc,
                      Path(ps_file).read_text() if ps_file else None)
    scanned, failed = [here], []
    if not all_nodes:
        return rows, scanned, failed
    for h in cfg.login_nodes:
        if h == here:
            continue
        remote = [sys.executable, str(Path(__file__).resolve()), "--config", str(cfg.path),
                  "scan", "--min-etime", str(min_etime)]
        if include_alloc:
            remote.append("--include-alloc")
        try:
            r = subprocess.run(cfg.ssh + [h, " ".join(map(shlex.quote, remote))],
                               stdin=subprocess.DEVNULL, capture_output=True,
                               text=True, timeout=180)
            if r.returncode != 0:
                raise RuntimeError(r.stderr.strip() or f"exit {r.returncode}")
            rows += json.loads(r.stdout)
            scanned.append(h)
        except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as e:
            warn(f"could not scan {h}: {e}")
            failed.append(h)
    return rows, scanned, failed


# --- runs -------------------------------------------------------------------

def run_dir(cfg: Config, run_id: str | None) -> Path:
    if not run_id:
        cur = cfg.state / "current"
        if not cur.exists():
            die("no current run - start one with: loginnode-notify detect")
        run_id = cur.read_text().strip()
    d = cfg.state / "runs" / run_id
    if not d.is_dir():
        die(f"no such run: {run_id}")
    return d


def load_run_file(run: Path, name: str, hint: str) -> dict:
    p = run / name
    if not p.exists():
        die(f"run {run.name} has no {name} - {hint}")
    return json.loads(p.read_text())


def selected_targets(targets: dict, only: list[str]) -> list[dict]:
    sel = [r for r in targets["users"] if r["selected"]]
    if only:
        known = {r["user"] for r in sel}
        for u in only:
            if u not in known:
                warn(f"{u} is not a selected target in this run")
        sel = [r for r in sel if r["user"] in only]
    return sel


# --- names ------------------------------------------------------------------

def sanitize_name(s: str) -> str:
    s = re.sub(r"[\x00-\x1f\x7f]", " ", s)
    return " ".join(s.split())[:80]


def read_pairs(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    if path.exists():
        for line in path.read_text().splitlines():
            if line.startswith("#") or not line.strip():
                continue
            f = line.split(None, 1)
            if len(f) == 2 and f[0] not in out:
                out[f[0]] = f[1].strip()
    return out


class Names:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.overrides = read_pairs(cfg.names_file)
        self.cache = read_pairs(cfg.name_cache)

    def _run(self, cmd: list[str]) -> str:
        try:
            return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True,
                                  text=True, errors="replace", timeout=20).stdout
        except (OSError, subprocess.TimeoutExpired):
            return ""

    def full(self, user: str) -> str | None:
        if user in self.cache:
            return self.cache[user]
        name = ""
        m = re.search(r"in real life:\s*(.*)", self._run([self.cfg.finger, user]), re.I)
        if m:
            name = sanitize_name(m.group(1))
            if name in ("???", user):
                name = ""
        if not name:
            gecos = self._run(["getent", "passwd", user]).split(":")
            name = sanitize_name(gecos[4].split(",")[0]) if len(gecos) > 4 else ""
        if not name:
            return None
        self.cache[user] = name
        with open(self.cfg.name_cache, "a") as fh:
            fh.write(f"{user}\t{name}\n")
        return name

    def greeting(self, user: str) -> str:
        if user in self.overrides:
            return self.overrides[user]
        name = self.full(user)
        if not name:
            return user
        return name.split()[0] if self.cfg.greet_first else name


# --- recipient addresses ----------------------------------------------------
# <netid>@yale.edu is not deliverable (Microsoft 365 drops it silently), and a
# bare netID only reaches people with a ~/.forward. The address YCRC has on
# file is the `mail` attribute in the HPC directory, read here through YCRC's
# own /apps/bin/ycrc_ldap.py (it needs ldap3, which ycrc_utilities' python has).

LDAP_LOOKUP = r"""
import json, sys
sys.path.insert(0, sys.argv[1])
import ycrc_ldap as y
from ldap3.utils.conv import escape_filter_chars
conn = y.connect()
out = {}
try:
    for u in sys.argv[2:]:
        conn.search(y.PEOPLE_BASE, "(uid=%s)" % escape_filter_chars(u), attributes=["mail"])
        out[u] = [str(m) for e in conn.entries if "mail" in e for m in e.mail.values]
finally:
    conn.unbind()
print(json.dumps(out))
"""
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")


class Emails:
    """netID -> address: etc/addresses.tsv override, else the HPC directory."""

    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.known = read_pairs(cfg.addresses_file)

    def lookup(self, users: list[str]) -> dict[str, str | None]:
        need = [u for u in dict.fromkeys(users) if u not in self.known]
        if need and self.cfg.ldap_helper_dir:
            cmd = [self.cfg.ldap_python, "-I", "-c", LDAP_LOOKUP, self.cfg.ldap_helper_dir] + need
            try:
                r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True,
                                   text=True, timeout=120)
                if r.returncode != 0:
                    raise RuntimeError((r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1])
                found = json.loads(r.stdout)
            except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as e:
                die(f"directory lookup failed ({e}); fix it or list addresses in "
                    f"{self.cfg.addresses_file}")
            for u in need:
                # Directory values can carry stray whitespace (" jdoe@example.org").
                self.known[u] = next((m.strip() for m in found.get(u) or [] if m.strip()), "")
        return {u: (self.known.get(u) if EMAIL_RE.match(self.known.get(u) or "") else None)
                for u in users}

    def one(self, user: str) -> str | None:
        return self.lookup([user])[user]


def self_test_address(cfg: Config) -> str:
    to = Emails(cfg).one(cfg.self_test_netid)
    if not to:
        die(f"no directory email for self_test_netid={cfg.self_test_netid}")
    return to


# --- messages ---------------------------------------------------------------

def parse_draft(path: Path) -> tuple[dict[str, str], str]:
    """Leading 'Header: value' lines up to a blank line, then the body."""
    lines = path.read_text().splitlines()
    headers: dict[str, str] = {}
    i, last = 0, None
    if lines and HEADER_RE.match(lines[0]):
        while i < len(lines) and lines[i].strip():
            if lines[i][0] in " \t" and last:
                headers[last] += " " + lines[i].strip()
            else:
                m = HEADER_RE.match(lines[i])
                if not m:
                    break
                last = m.group(1).lower()
                headers[last] = m.group(2).strip()
            i += 1
        while i < len(lines) and not lines[i].strip():
            i += 1
    for h in headers:
        if h not in DRAFT_HEADERS:
            warn(f"{path.name}: header '{h}' is not used (only Subject and Reply-To are)")
    return headers, "\n".join(lines[i:]).rstrip() + "\n"


def make_message(cfg: Config, to: str, subject: str, body: str,
                 reply_to: str | None = None) -> EmailMessage:
    msg = EmailMessage()
    msg["From"] = cfg.mail_from
    msg["To"] = to
    if reply_to or cfg.reply_to:
        msg["Reply-To"] = reply_to or cfg.reply_to
    msg["Subject"] = subject
    msg["Date"] = formatdate(localtime=True)
    msg["Message-ID"] = make_msgid(domain=cfg.mail_domain)
    msg.set_content(body)
    return msg


def show_message(msg: EmailMessage) -> None:
    for h in ("To", "Reply-To", "Subject"):
        if msg[h]:
            print(f"{h}: {msg[h]}")
    print()
    print(msg.get_content().rstrip())


def deliver(cfg: Config, msg: EmailMessage) -> str | None:
    """Hand the message to sendmail; returns an error string or None."""
    cmd = cfg.sendmail + ["-t", "-oi"]
    if cfg.envelope_from:
        cmd += ["-f", cfg.envelope_from]
    try:
        r = subprocess.run(cmd, input=msg.as_bytes(), capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)
    if r.returncode != 0:
        return f"{cmd[0]} exit {r.returncode}: {r.stderr.decode(errors='replace').strip()}"
    return None


def nudge(cfg: Config, user: str, hosts: list[str]) -> None:
    """Best-effort one-line `write` to the user's terminals."""
    text = (f"Hi from {cfg.mail_from}: I just emailed you about a process on this login "
            f"node - could you move it into an allocation? (one-time notice)\n")
    here = short_host()
    for h in hosts:
        remote = [] if h == here else cfg.ssh + [h]
        try:
            who = subprocess.run(remote + ["who"], stdin=subprocess.DEVNULL,
                                 capture_output=True, text=True, timeout=30).stdout
        except (OSError, subprocess.TimeoutExpired):
            warn(f"nudge: could not list terminals on {h}")
            continue
        for tty in [f[1] for f in map(str.split, who.splitlines()) if len(f) > 1 and f[0] == user]:
            cmd = remote + (["write", user, tty] if not remote
                            else [f"write {shlex.quote(user)} {shlex.quote(tty)}"])
            try:
                ok = subprocess.run(cmd, input=text, capture_output=True, text=True,
                                    timeout=30).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
            print(f"  nudge {user}@{h}:{tty} {'ok' if ok else 'failed (mesg n?)'}")


class SendLock:
    def __init__(self, cfg: Config):
        self.path = cfg.state / "send.lock"

    def __enter__(self):
        self.fh = open(self.path, "a")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            die("another send is running")
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


